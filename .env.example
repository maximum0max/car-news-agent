# Copy this file to .env (never commit .env)
# These values are read automatically when running locally.
# In GitHub Actions, set these as repo secrets instead.

OPENAI_API_KEY=sk-...
PEXELS_API_KEY=...
WP_URL=https://yourdomain.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
